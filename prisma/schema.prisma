datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  routine      Routine?
}

// `id` is the SHA-256 hash of the token stored in the browser cookie, so a
// leaked database does not expose usable session tokens.
model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One routine per user. `userId` is nullable only so the routine that existed
// before accounts were added can wait, unowned, until an admin assigns it to a
// user when creating that user's account.
model Routine {
  id        Int      @id @default(autoincrement())
  userId    Int?     @unique
  name      String   @default("My Daily Routine")
  intervals String
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
